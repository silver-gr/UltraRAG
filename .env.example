# UltraRAG Configuration Example
# Copy this file to .env and fill in your values

# ===== REQUIRED SETTINGS =====

# Path to your Obsidian vault
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# Vault name for Obsidian URI links (enables clickable source links in UI)
# This should match your vault name in Obsidian exactly (case-sensitive)
# Example: "My Notes" or "Personal Vault"
OBSIDIAN_VAULT_NAME=

# Auto-load existing index when Streamlit starts (skip manual button click)
# Set to false to require manual "Load Existing Index" button click
AUTOLOAD_INDEX=true

# ===== WEB APP SECURITY / MULTI-USER =====

# Enable in-app authentication and role gating (admin/user)
ULTRARAG_AUTH_ENABLED=true

# Local users JSON path (managed with `python -m scripts.manage_users ...`)
ULTRARAG_USERS_PATH=data/auth/users.json

# Session timeout in minutes
ULTRARAG_SESSION_TIMEOUT_MINUTES=720

# Optional: allow self-signup in UI (default false)
ULTRARAG_ALLOW_SIGNUP=false

# Global app concurrency control (across users/sessions)
ULTRARAG_MAX_CONCURRENT_JOBS=1

# Per-user cooldown between queries (seconds)
ULTRARAG_MIN_SECONDS_BETWEEN_QUERIES=2

# Max wait time to acquire a global job slot
ULTRARAG_JOB_ACQUIRE_TIMEOUT_SECONDS=120

# Optional override for Content Research export base directory.
# If unset, exports are per-user under data/users/<username>/research-exports
# ULTRARAG_CONTENT_RESEARCH_DIR=/absolute/path/to/research-exports

# Google API Key (for Gemini LLM)
GOOGLE_API_KEY=your_google_api_key_here


# ===== EMBEDDING MODEL =====

# Options: voyage-4-lite, voyage-4-large, voyage-3.5-lite, qwen3-8b, openai-3-large
# - voyage-4-lite: Best value, shared embedding space with voyage-4-large (free tier: 200M tokens)
# - voyage-4-large: Highest quality Voyage model (paid, shared space with voyage-4-lite)
# - voyage-3.5-lite: Previous generation (free tier: 200M tokens)
# - qwen3-8b: Best open-source (free, self-hosted)
# - openai-3-large: Good balance (requires OPENAI_API_KEY)
EMBEDDING_MODEL=voyage-4-lite

# Token limit for embedding model (default: 200M for free tier)
EMBEDDING_TOKEN_LIMIT=200000000

# Chunking configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=75

# Chunking strategy
# Options:
#   - obsidian_aware: Structure-preserving (recommended for Obsidian)
#   - markdown_semantic: Markdown + semantic splitting
#   - late_chunking: Best accuracy (+10-12%), slower indexing
#   - semantic: Pure semantic chunking
#   - simple: Fast, basic sentence splitting
CHUNKING_STRATEGY=obsidian_aware

# Late chunking configuration (if using late_chunking strategy)
# Alpha controls balance between local (chunk) and global (document) context
# Values: 0.0-1.0 (default: 0.7 = 70% local, 30% global)
LATE_CHUNKING_ALPHA=0.7


# ===== VECTOR DATABASE =====

# Options: lancedb, qdrant
# - lancedb: Embedded, zero-setup (recommended for personal use)
# - qdrant: Production-grade, scalable (requires Qdrant server)
VECTOR_DB=lancedb

# LanceDB settings
LANCEDB_PATH=./data/lancedb

# Qdrant settings (if using Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=obsidian_notes


# ===== LLM SETTINGS =====

# LLM model (default: gemini-3-flash-preview)
LLM_MODEL=gemini-3-flash-preview
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=65536  # Gemini 3 Flash supports up to 65,536 output tokens

# LLM backend: "api" or "cli"
# - api: Uses Google Gemini API directly (requires GOOGLE_API_KEY)
# - cli: Uses Gemini CLI with separate free tier quota (1000 req/day, 60/min)
#        Install: npm install -g @google/gemini-cli
#        Auth: Run `gemini` once to authenticate with Google
LLM_BACKEND=api


# ===== RETRIEVAL SETTINGS =====

# Number of chunks for UI display / backward compat
TOP_K=75

# Candidates to fetch from vector+BM25 before reranking (over-fetch ratio)
RETRIEVAL_CANDIDATES=150

# Number of chunks to keep after reranking
RERANK_TOP_N=20

# Reranker model to use
# Options: voyage-rerank-2.5, voyage-rerank-2 (requires VOYAGE_API_KEY)
# - voyage-rerank-2.5: Latest model (free tier: 200M tokens)
RERANKER_MODEL=rerank-2.5

# Token limit for reranker model (default: 200M for free tier)
RERANKER_TOKEN_LIMIT=200000000

# Enable hybrid search (vector + query fusion)
ENABLE_HYBRID_SEARCH=true

# Similarity threshold (0.0-1.0)
SIMILARITY_THRESHOLD=0.3

# Self-RAG response validation (post-generation hallucination check)
VALIDATE_RESPONSES=true

# HyDE temperature (higher = more diverse hypothetical documents, default: 0.7)
HYDE_TEMPERATURE=0.7

# MMR diversity: cap chunks per source document to prevent single-doc dominance
ENABLE_MMR=false
MMR_LAMBDA=0.5
MAX_CHUNKS_PER_DOCUMENT=5

# Evaluation logging (logs retrieval metrics to data/evaluation_log.json)
ENABLE_EVALUATION_LOGGING=false

# Query transformation method for improved retrieval
# Options:
#   - hyde: Hypothetical Document Embeddings (generates hypothetical answer, embeds that)
#   - multi_query: Generates multiple query variations (3-5) and combines results
#   - both: Combines HyDE + multi-query for maximum recall
#   - none/disabled: No query transformation
QUERY_TRANSFORM_METHOD=hyde

# Number of query variations for multi_query or both methods
QUERY_TRANSFORM_NUM_QUERIES=3

# Post-rerank score threshold (filters low-relevance results after reranking)
# Different scale from SIMILARITY_THRESHOLD — reranker scores vary by model
# Set to 0 to disable (default). Try 0.1 to filter obviously irrelevant results.
RERANK_SCORE_THRESHOLD=0.0

# Query decomposition (split complex multi-part queries before retrieval)
# Example: "Compare X and Y" → retrieves X and Y independently, merges with RRF
ENABLE_QUERY_DECOMPOSITION=false

# Contextual compression (extract relevant sentences from chunks post-rerank)
# Reduces LLM token usage by compressing chunks to query-relevant sentences
ENABLE_CONTEXTUAL_COMPRESSION=false

# RRF (Reciprocal Rank Fusion) tuning
# Lower k = more weight to top-ranked results (default: 60)
RRF_K=60
# Weights for vector vs BM25 in fusion (default: equal weight 1.0)
FUSION_VECTOR_WEIGHT=1.0
FUSION_BM25_WEIGHT=1.0

# Self-correction settings (Self-RAG and CRAG patterns)
# Enable self-correcting retrieval with relevance grading and query refinement
USE_SELF_CORRECTION=true

# Maximum number of retry attempts if retrieval is AMBIGUOUS or INCORRECT
SELF_CORRECTION_MAX_RETRIES=2

# Research mode settings (iterative retrieval with gap analysis)
# Enable research mode for complex multi-step queries
ENABLE_RESEARCH_MODE=true

# Maximum iterations for research refinement
RESEARCH_MAX_ITERATIONS=3

# Confidence threshold to stop research iterations (0.0-1.0)
RESEARCH_CONFIDENCE_THRESHOLD=0.8

# Max sub-queries per iteration
RESEARCH_MAX_SUBQUERIES=3

# Max sources to use for LLM synthesis in research mode (0 = unlimited, default)
# Research mode can analyze ALL sources regardless of UI display limit
# Set to a number like 500 to cap synthesis if needed
RESEARCH_MAX_SYNTHESIS_SOURCES=0


# ===== AI CONVERSATIONS INDEX (OPTIONAL) =====

# Enable federated search across vault + AI conversations
CONVERSATIONS_ENABLED=false

# Path to AI conversation exports (from AI-Conversations-Export-Toolkit)
# CONVERSATIONS_PATH=/path/to/ai-conversations/output

# Weight for conversation results vs vault results (0.0-2.0)
# Lower = vault prioritized, Higher = conversations prioritized
CONVERSATIONS_WEIGHT=0.8

# Include conversations in default search (or require @conv/@all prefix)
CONVERSATIONS_IN_DEFAULT_SEARCH=true


# ===== BOOKS INDEX (OPTIONAL) =====

# Enable federated search across vault + books (EPUB/PDF)
BOOKS_ENABLED=false

# Path to books directory containing EPUB and PDF files
# BOOKS_PATH=/path/to/your/books

# Weight for book results vs vault results (0.0-2.0)
# Higher values prioritize book content
BOOKS_WEIGHT=0.9

# Include books in default search (or require @books prefix)
BOOKS_IN_DEFAULT_SEARCH=true

# LanceDB table name for books index
BOOKS_TABLE_NAME=books

# Book-specific chunking controls
# BOOK_CHUNK_SIZE=1024          # Chunk size for books (larger than vault notes)
# BOOK_CHUNK_OVERLAP=128        # Overlap between book chunks
# BOOK_MIN_CHUNK_SIZE=100       # Minimum chunk size (discard smaller)
# BOOK_RESPECT_CHAPTERS=true    # Split on chapter boundaries
# BOOK_RESPECT_PARAGRAPHS=true  # Split on paragraph boundaries
# BOOKS_METADATA_CACHE_PATH=data/book_metadata_cache.json

# Books metadata enrichment (optional)
# CALIBRE_DB_PATH=/Volumes/6937130292/Βιβλιοθήκη/metadata.db
# CALIBRE_MATCH_THRESHOLD=0.75
# BOOKS_EXCLUDE_TAGS=audio,notbooks,have read,oldstuff,reading,quick,su
# BOOKS_WEB_ENRICH=false
# BOOKS_WEB_ENRICH_MAX=50


# ===== SAVED ITEMS / THESOURCE (OPTIONAL) =====

# Enable federated search across vault + TheSource saved items
SAVED_ITEMS_ENABLED=false

# Weight for saved_items results vs vault results (0.0-2.0)
SAVED_ITEMS_WEIGHT=0.5

# Path to the shared LanceDB containing saved_items table
# Defaults to ~/Projects/shared-data/lancedb
# SAVED_ITEMS_LANCEDB_PATH=/Users/yourname/Projects/shared-data/lancedb

# LanceDB table name for saved items (default: saved_items)
# SAVED_ITEMS_TABLE_NAME=saved_items


# ===== GRAPH DATABASE (OPTIONAL, PHASE 2) =====

# Enable graph-based search
ENABLE_GRAPH_SEARCH=false

# Neo4j settings (if using graph features)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password


# ===== API KEYS =====

# Voyage AI (for embeddings and reranking)
# Get free key at: https://www.voyageai.com/
VOYAGE_API_KEY=your_voyage_api_key_here

# OpenAI (if using OpenAI embeddings)
# Get key at: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here


# ===== COST DISPLAY SETTINGS =====

# Currency exchange rate (1 USD = X EUR)
# Get current rate from Google Cloud Console billing
CURRENCY_EXCHANGE_RATE=0.8633

# VAT rate for cost display (0.24 = 24%)
# Set to 0 to disable VAT display
VAT_RATE=0.24


# ===== NOTES =====
#
# Recommended setup for beginners:
# - EMBEDDING_MODEL=qwen3-8b (free, no API key needed)
# - VECTOR_DB=lancedb (no server setup needed)
# - GOOGLE_API_KEY=<your key> (Gemini has generous free tier)
#
# Recommended setup for best quality:
# - EMBEDDING_MODEL=voyage-3-large
# - VECTOR_DB=lancedb
# - VOYAGE_API_KEY=<your key>
# - GOOGLE_API_KEY=<your key>
#
# Cost estimate (1,650 notes):
# - Initial indexing: $13-40 (one-time with Voyage)
# - Monthly usage: $5-20 (moderate use)
# - Self-hosted: $0 (using qwen3-8b + Gemini free tier)
